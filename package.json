    "build:impressctf": "pnpm --filter impressctf build",
    "build:tekromancy": "pnpm --filter @tekromancy/showcase build",
    "preview:impressctf": "pnpm --filter impressctf preview",
    "preview:tekromancy": "pnpm --filter @tekromancy/showcase preview",
    "start": "pnpm --filter impressctf preview",
    "test": "pnpm -r test"
  },
